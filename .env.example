# copia este archivo como .env.local para usar los microservicios de watchnext-backend
# true = microservicios reales, false o vacio = mocks de siempre
VITE_USE_API=true
# gateway del backend (docker compose lo deja en el puerto 8080)
VITE_GATEWAY_URL=http://localhost:8080
# idioma que se le pide a tmdb
VITE_API_LANGUAGE=es-MX
